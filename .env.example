# ==============================================================================
# PulseGear Environment Configuration Template
# ==============================================================================

# Django Core
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,pulsegear.yourdomain.com

# Database (PostgreSQL URL or SQLite default)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://pulseuser:pulsepass@localhost:5432/pulsegear_db

# Stripe Payments Configuration
STRIPE_PUBLIC_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# AWS S3 Storage (Optional - For Production Media Assets)
USE_S3=False
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=pulsegear-bucket
AWS_S3_REGION_NAME=us-east-1
